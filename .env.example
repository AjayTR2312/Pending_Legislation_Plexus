# Copy to .env and fill in the secrets. Every setting is optional unless noted: the value shown
# is the built-in default. Generated by `python app/settings.py --write-example`; edit settings.py,
# not this file. Resolution order: process environment > .env > default.

# ── AI models ─────────────────────────────────────────────────────────
# Model every call asks for.
LLM_MODEL=claude-opus-5-5
# Used when LLM_MODEL is unavailable, overloaded or erroring. Set to `none` to disable the fallback.
LLM_FALLBACK_MODEL=claude-opus-4-7
# USD-per-1M-token price sheet used for cost reports. Edit the file when prices change.
LLM_PRICING_FILE=config/model_pricing.json
# Cache large system prompts (the state prompts). A hit reads them at the cached rate (~5% of input price); a miss pays 1.25x on that part. Auto-disables itself if the gateway rejects cache markers.
LLM_PROMPT_CACHE=True
# Only cache when it will pay off: another job for the same state is waiting, or the cache is already warm. A lone document pays ~25% extra on the cached part and nothing ever reads it. false = always cache (when LLM_PROMPT_CACHE is on).
LLM_CACHE_AUTO=True
# How long a cached prompt counts as warm (the API keeps it 5 minutes).
LLM_CACHE_WARM_S=240
# Only system prompts at least this long are cached (the API ignores caching below ~1,000-4,000 tokens).
LLM_CACHE_MIN_CHARS=4000
# Tries on the primary model when it answers 'overloaded', before switching.
LLM_PRIMARY_ATTEMPTS=3
# Tries on the last model in the chain (nowhere left to fall back to).
LLM_LAST_ATTEMPTS=5
# max_tokens for the hybrid text-clean call.
LLM_MAX_TOKENS_CLEAN=16384
# max_tokens for streamed visual conversion, reconcile, self-correct and tag audit.
LLM_MAX_TOKENS_STREAM=128000
# max_tokens for per-chunk hybrid conversion calls.
LLM_MAX_TOKENS_CHUNK=64000
# max_tokens for the diff-verifier call.
LLM_MAX_TOKENS_VERIFY=8000
# max_tokens for the tiny connectivity / smoke-test call.
LLM_MAX_TOKENS_PING=100
# Request timeout (seconds) for large chunk calls.
LLM_CHUNK_TIMEOUT_S=600.0

# ── AI platform auth ──────────────────────────────────────────────────
# CIAM M2M client id. With CIAM_CLIENT_SECRET + ASSET_ID, CIAM auth is tried first.
CIAM_CLIENT_ID=
# CIAM M2M client secret.
CIAM_CLIENT_SECRET=
# CIAM asset id.
ASSET_ID=
# Workspace id for the token-exchange fallback.
TR_WORKSPACE_ID=AgentTraininJaH4
# Token endpoint for the workspace fallback.
TR_ANTHROPIC_TOKEN_URL=https://aiplatform.gcs.int.thomsonreuters.com/v1/anthropic/token
# Timeout (seconds) for a token request.
TOKEN_TIMEOUT_S=60
# Comma list of waits between token-request tries on timeouts / connection errors / 5xx.
TOKEN_RETRY_DELAYS_S=5,15,30

# ── SFTP / Keyed ──────────────────────────────────────────────────────
# SFTP server.
SFTP_HOST=10.17.38.130
# SFTP port.
SFTP_PORT=22
# SFTP user.
SFTP_USER=mag2ftp
# SFTP password. Required to download or submit.
FTP_PASSWORD=
# Remote folder 'Submit to Keyed' uploads to.
SFTP_UPLOAD_DIR=/apps/Codes/MP2/LandingStrips/LCPR/ftp/keyed
# Remote folder the pipeline downloads from.
SFTP_DOWNLOAD_DIR=/apps/Codes/MP2/LandingStrips/LCPR/ftp/out

# ── Folders and files ─────────────────────────────────────────────────
# Scratch root for sessions and downloads.
# APP_TMP_DIR=            (default: derived from the project folder)
# Local folder ftp_upload.py scans for output/*.txt.
# UPLOAD_SOURCE_DIR=            (default: derived from the project folder)
# Local folder ftp_download.py saves into.
# DOWNLOAD_DEST_DIR=            (default: derived from the project folder)
# React trial app storage (jobs DB, edits, approved copies).
# TRIAL_STORAGE_DIR=            (default: derived from the project folder)
# SQLite job database.
# TRIAL_DB_PATH=            (default: derived from the project folder)
# Folder containing tesseract (OCR). Blank = find it on PATH or in the usual install folders.
TESSERACT_DIR=
# State clean-prompt files ({ST}_Clean_Prompt.txt).
PROMPTS_DIR=data/Prompts
# NetScan per-state markup spec.
STATE_SPEC_FILE=Opus4.6/netscan_state_template.json

# ── Limits ────────────────────────────────────────────────────────────
# Files per batch in the Streamlit app.
STREAMLIT_MAX_BATCH_FILES=20
# Total upload size per batch (Streamlit).
BATCH_MAX_TOTAL_SIZE_MB=50
# Page limit for PyMuPDF / hybrid conversion.
MAX_PAGES_PYMUPDF=15
# Page limit for vision (scanned) conversion.
MAX_PAGES_VISION=50
# Files per batch in the React app.
WEBAPP_MAX_BATCH_FILES=50
# Default poll interval of pipeline_runner --poll.
PIPELINE_POLL_MINUTES=5
# Safety cap on page-image DPI for vision conversion.
VISUAL_MAX_DPI=600

# ── Audit and verification ────────────────────────────────────────────
# Tag-audit checklist items per API call.
AUDIT_CHECKLIST_CHUNK_SIZE=250
# Page images per tag-audit call (keeps requests under the size limit).
AUDIT_MAX_IMAGES_PER_CHUNK=20
# Longest side (px) of an audit page image.
AUDIT_MAX_IMAGE_DIM=2000
# Differences per diff-verifier call.
VERIFY_MAX_DIFFS_PER_BATCH=40
# Page images per diff-verifier call.
VERIFY_MAX_IMAGES_PER_CALL=12
# Largest difference (words) the verifier may auto-demote.
VERIFY_MAX_AUTO_DEMOTE_WORDS=15

# ── React app and API ─────────────────────────────────────────────────
# Port the FastAPI backend listens on (the UI proxy points here).
API_PORT=8800
# Where the React UI is served.
UI_URL=http://localhost:5173
# Comma list of origins allowed by CORS.
UI_ORIGINS=http://localhost:5173
# A 'processing' job untouched this long is returned to the queue.
JOB_STALE_SECONDS=1800
# SQLite lock wait (seconds).
DB_TIMEOUT_S=30.0
# How often worker.py looks for queued jobs.
WORKER_POLL_SECONDS=2.0
# Activity-log lines kept per job.
JOBLOG_MAX_ENTRIES=1000
# DPI of the PDF page images in the review screen.
COMPARE_RENDER_DPI=150
# PDF boxes drawn per finding.
REVIEW_MAX_BOXES=60
# Revisions listed per document.
REVIEW_MAX_REVISIONS=1500
# Findings kept per validation rule.
RULES_MAX_PER_RULE=40
