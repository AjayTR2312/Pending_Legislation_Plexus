    "CO": {
      "state_name": "Colorado",
      "abbreviation": "CO",
      "file_type": ".pdf-text",
      "deletions": "Remove line numbers, bill page footer (shading denotes...), subsequent page footers (page #/bill#). KEEP all first page header information including session details (e.g., 'Second Regular Session', 'Seventy-fifth General Assembly'), state name, bill status (e.g., 'INTRODUCED'), and LLS numbers",
      "add_markup": {
        "underline": false,
        "bold": false,
        "italic": false,
        "all_caps": true,
        "all_caps_condition": "w/in text (not 'SECTION' at the beginning of a line)",
        "brackets": false,
        "custom_rules": [
          "Begin mark up at line numbered lines starting with number 1",
          "When an entire new subsection is added (the subsection label AND all its content are new), include the subsection label inside the [A> tag — this applies to ANY label form: numeric e.g. (1), (2.5), letter e.g. (a), (b), Roman numeral e.g. (I), (II), or combined e.g. (2)(c)(I). Example: [A>(a) ALL CAPS TEXT HERE<A] — NOT (a) [A>ALL CAPS TEXT HERE<A]",
          "When ALL CAPS added text contains numbers, lowercase connectors, or subsection references within the same continuous replacement clause (e.g. 'PART 3, 4, 6, 7, 9, OR 19' or 'SUBSECTION (2.5)(b)(I)'), include them inside the same single [A> tag — do NOT split into separate tags per ALL CAPS word",
          "Skip the state logo/seal image. If the bill begins with 'An Act' text at the top of the first page, include it as the first line of output."
        ]
      },
      "delete_markup": {
        "strike_out": true,
        "brackets": false,
        "custom_rules": [
          "For signature blocks at the end: transcribe the signature line as '______________________________', then the printed name and title below it. Do NOT transcribe the actual handwritten signature image itself."
        ]
      }
    },
    "DC": {
      "state_name": "District of Columbia",
      "abbreviation": "DC",
      "file_type": ".pdf-text or .pdf-tif",
      "deletions": "headers (ex: 'enrolled original'), footers, line numbers, page numbers. NOTES on right margin move to left justified on separate line above the one on which it appears",
      "add_markup": {
        "underline": true,
        "bold": false,
        "italic": false,
        "all_caps": false,
        "brackets": false,
        "custom_rules": ["Underline tags muts be added only when the text is visually underlined in the source document, Do not add underline tags to text inside quotation marks(\")."]
      },
      "delete_markup": {
        "strike_out": true,
        "brackets": false,
        "custom_rules": ["Do NOT add markup tags to text that is italicized."]
      }
    },
    "IN": {
      "state_name": "Indiana",
      "abbreviation": "IN",
      "file_type": ".pdf",
      "deletions": "line numbers, page numbers on the header, footers",
      "add_markup": {
        "underline": false,
        "bold": true,
        "italic": false,
        "all_caps": false,
        "brackets": false,
        "custom_rules": [
          "Do NOT tag these three specific bold labels: Citations Affected:, Synopsis:, Effective:. These are digest metadata — output them as plain text. Tag ALL other bold text everywhere else in the document, including bold text in the PRINTING CODE section.",
          "NEVER use asterisks (*) anywhere in the output. Italic text must be output as plain text with NO markers — no *text*, no **text**, no markdown of any kind. If text is italic in the PDF, just output the plain words."
        ]
      },
      "delete_markup": {
        "strike_out": true,
        "brackets": false,
        "custom_rules": []
      }
    },
    "KS": {
      "state_name": "Kansas",
      "abbreviation": "KS",
      "file_type": ".pdf-text",
      "deletions": "line numbers, headers on page two and subsequent (bill number, page #). KEEP all content on page one including any amendment status line (e.g., 'As Amended by Senate Committee', 'As Amended by House Committee').",
      "add_markup": {
        "underline": true,
        "bold": true,
        "italic": true,
        "all_caps": false,
        "brackets": false,
        "custom_rules": [
          "Do not apply add to 'Be it enacted by the Legislature of the State of Kansas:'",
          "KS italic text indicates newly added legislative language. Always wrap italic text in [A>...<A] tags. NEVER render italic as markdown asterisks (*text*). Correct: [A>italic text<A]. Wrong: *italic text* or *[A>italic text<A]*.",
          "NEVER put markdown asterisk characters (*) inside [A>...<A] or [D>...<D] tags. Content inside redline tags must be completely plain text with no asterisks, no underscores, no markdown of any kind."
        ]
      },
      "delete_markup": {
        "strike_out": true,
        "brackets": false,
        "custom_rules": [
          "KEEP the amendment status line that appears at the top of page one (e.g., 'As Amended by Senate Committee', 'As Amended by House Committee'). This is bill metadata, not a repeating page header — do NOT remove it."
        ]
      }
    },
