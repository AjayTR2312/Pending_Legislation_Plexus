      "state_name": "Arkansas",
      "abbreviation": "AR",
      "file_type": ".pdf-text",
      "deletions": "Remove line numbers, all footers, page numbers, headers starting on page 2. KEEP the first line explanation on page 1 (e.g., 'Stricken language would be deleted from and underlined language would be added to present law.')",
      "add_markup": {
        "underline": true,
        "bold": false,
        "italic": false,
        "all_caps": false,
        "brackets": false,
